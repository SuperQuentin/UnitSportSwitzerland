; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UnitSportSwitzerland"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="UnitSportSwitzerland"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/size.mobile=2048
scaling_3d/scale=0.75
textures/vram_compression/import_etc2_astc=true

[shader_globals]

world_disco_beat={
"type": "float",
"value": 0.0
}
xr_smooth={
"type": "bool",
"value": false
}
world_sun_dir={
"type": "vec3",
"value": Vector3(0.45, 0.8, 0.25)
}
world_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
world_sky={
"type": "vec3",
"value": Vector3(0.48, 0.57, 0.71)
}
world_night={
"type": "float",
"value": 0.0
}
world_snow={
"type": "float",
"value": 0.0
}
world_mist_color={
"type": "vec3",
"value": Vector3(0.5, 0.5, 0.5)
}
world_mist_density={
"type": "float",
"value": 0.0
}
world_mist_top={
"type": "float",
"value": 0.0
}
world_lights={
"type": "float",
"value": 0.0
}
world_origin_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
water_wave_0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_wave_1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_wave_2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_wave_3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_wave_4={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_wave_5={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_amp_a={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_amp_b={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
water_time={
"type": "float",
"value": 0.0
}
world_cam_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
world_door_light_0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
world_door_light_1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
world_door_light_2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
world_door_light_3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
portal_clip_eye_0={
"type": "vec3",
"value": Vector3(0, 1000000000, 0)
}
portal_clip_plane_0={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
portal_clip_eye_1={
"type": "vec3",
"value": Vector3(0, 1000000000, 0)
}
portal_clip_plane_1={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
portal_clip_eye_2={
"type": "vec3",
"value": Vector3(0, 1000000000, 0)
}
portal_clip_plane_2={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
portal_clip_eye_3={
"type": "vec3",
"value": Vector3(0, 1000000000, 0)
}
portal_clip_plane_3={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}

[xr]

openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=true
shaders/enabled=true

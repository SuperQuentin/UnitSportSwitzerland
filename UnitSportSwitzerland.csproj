<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>UnitSport</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- SDL3 (steering wheel, SteeringWheel.cs) is a C API: its handles are pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- keep the offline tools, the tests and the data folders out of the game assembly's wildcard compile -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**;tests/**;terrain_chunks/**;ressources/**;test_output/**</DefaultItemExcludes>
    <!-- MapCore references the TerrainPreprocessor and RoadGen exe projects (#515). Their apphost, deps.json and
         runtimeconfig.json collide when Godot publishes for a RID (NETSDK1152), and the export then ships without
         the game assemblies (#548). The game never runs those files, so whichever copy wins doesn't matter. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- Android APK (tools/release.sh, #544): Godot's prebuilt Android template only runs net9.0 -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'android' ">
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <!-- iOS (tools/ios-build.sh, #1025): NativeAOT makes one dylib of the game's ~15 MB of IL, and its code has to
       stay under 128 MB, the reach of an ARM64 branch: -ld_classic inserts no branch islands, and Xcode's current
       linker asserts on NativeAOT objects ("too many large addends", .NET 8 and 9 alike). Speed-optimised it came
       out ~134 MB; size optimisation and folding identical method bodies bring it under. net9.0 like Android. -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'ios' ">
    <TargetFramework>net9.0</TargetFramework>
    <UseLdClassicXCodeLinker>true</UseLdClassicXCodeLinker>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <!-- ... and the APK carries every .so of the publish folder (#1082): keep out SDL (the wheel never starts on a
       phone), mono's debugger, hot-reload and tracing components (mono falls back to its built-in stubs), ONNX
       Runtime's natives (a phone never runs the vocal model, VocalSeparator.ModelName; its 53 MB .aar landed in
       assets/) and the runtime pack's static .a libraries, which Android never loads -->
  <Target Name="DropUnusedAndroidNatives" AfterTargets="ComputeResolvedFilesToPublishList" Condition=" '$(GodotTargetPlatform)' == 'android' ">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition=" '%(Filename)%(Extension)' == 'libSDL3.so' or '%(Filename)' == 'libmono-component-debugger' or '%(Filename)' == 'libmono-component-hot_reload' or '%(Filename)' == 'libmono-component-diagnostics_tracing' or '%(Extension)' == '.a' or $([System.String]::Copy('%(Filename)').StartsWith('onnxruntime')) or $([System.String]::Copy('%(Filename)').StartsWith('libonnxruntime')) " />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Tiles churn through the large-object heap (1-4 MB grids, covers, collision maps), which
         the GC never compacts by default: the heap grows with fragmentation, not live data.
         ConserveMemory (0-9) lets it compact the LOH when fragmentation gets high. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!-- home trainers (#901): RideLink, and the Windows TFM its Bluetooth needs -->
  <Import Project="tools\RideLink\Game.props" />

  <ItemGroup>
    <ProjectReference Include="tools\TerrainFormat\TerrainFormat.csproj" />
    <!-- The map screen's country map, selection, plan and estimates, shared with the terminal
         region wizard (tools/MapSetup). It embeds switzerland.bin, so no data folder is involved. -->
    <ProjectReference Include="tools\MapCore\MapCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the coarse heightmap the generated terrain is shaped on (tools/swiss_relief.py); LogicalName
         and WithCulture because MSBuild otherwise reads ".bin"-like infixes as a culture -->
    <EmbeddedResource Include="src/Terrain/swiss_relief.gz" LogicalName="swiss_relief.gz" WithCulture="false" />
    <!-- the earth fill's photo statistics for its biome guess (#1809, World/Globe/BiomePhotoBake from Blue Marble NG) -->
    <EmbeddedResource Include="src/Terrain/Biomes/photo_stats.bin.gz" LogicalName="photo_stats.bin.gz" WithCulture="false" />
    <!-- every OSM venue (#1232, the preprocessor venue stage, docs/notes/terrain/entertainment-venues.md): ODbL, like Castles.List.cs -->
    <EmbeddedResource Include="src/Interiors/venues.tsv.gz" LogicalName="venues.tsv.gz" WithCulture="false" />
    <!-- the errand givers OSM and the tiles know (#1339, the preprocessor givers stage): ODbL; left out until a build has written the file -->
    <EmbeddedResource Include="src/Adventure/Errands/givers.tsv.gz" LogicalName="givers.tsv.gz" WithCulture="false" Condition="Exists('src/Adventure/Errands/givers.tsv.gz')" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
  </ItemGroup>

  <!-- Godot's iOS export always publishes the simulator slices too (iossimulator-arm64 and -x64, ~45 min of NativeAOT
       each on the CI runner). tools/ios-build.sh sets UNITSPORT_IOS_DEVICE_ONLY unless asked for the simulator: those
       publishes then compile no game code, and the simulator slice of the app is an empty stub. -->
  <ItemGroup Condition=" '$(UNITSPORT_IOS_DEVICE_ONLY)' == '1' and $(RuntimeIdentifier.StartsWith('iossimulator')) ">
    <Compile Remove="@(Compile)" />
    <EmbeddedResource Remove="@(EmbeddedResource)" />
    <ProjectReference Remove="@(ProjectReference)" />
  </ItemGroup>

  <!-- SDL (steering wheel) never starts on a phone (SteeringWheel.Install), and the package's iOS library lands in
       the device folder as its simulator build, which fails the Xcode link: iOS ships without it. Below the
       Include, since Update only reaches items already defined. -->
  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'ios' ">
    <PackageReference Update="ppy.SDL3-CS" ExcludeAssets="native" />
  </ItemGroup>

  <!-- The playtest suite (#751, docs/notes/general/playtest.md): an in-game MCP server Claude Code drives the
       running game through (scenarios, tunables, screenshots, chat). A local control port, so it is compiled
       only into the editor's Debug configuration: ExportDebug, ExportRelease and Android builds carry none of it. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>$(DefineConstants);PLAYTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition=" '$(Configuration)' != 'Debug' ">
    <Compile Remove="src/Playtest/**" />
  </ItemGroup>

  <!-- Build features (#1074, docs/notes/general/build-features.md): dev tools an exported build may leave out. The
       editor (Debug) has all of them, so tools/test.sh and every probe keep working. An export (ExportRelease,
       ExportDebug) has none unless UNITSPORT_FEATURES lists them: "trailer", or "all". An environment variable, so
       Godot's dotnet publish sees it: UNITSPORT_FEATURES=trailer tools/release.sh. -->
  <PropertyGroup>
    <UnitSportFeatures Condition=" '$(Configuration)' == 'Debug' ">all</UnitSportFeatures>
    <UnitSportFeatures Condition=" '$(Configuration)' != 'Debug' ">$(UNITSPORT_FEATURES)</UnitSportFeatures>
    <_UnitSportFeatureList>;$(UnitSportFeatures.ToLowerInvariant().Replace(',', ';').Replace(' ', ''));</_UnitSportFeatureList>
    <UnitSportTrailer>false</UnitSportTrailer>
    <UnitSportTrailer Condition=" $(_UnitSportFeatureList.Contains(';all;')) or $(_UnitSportFeatureList.Contains(';trailer;')) ">true</UnitSportTrailer>
  </PropertyGroup>
  <!-- The trailer studio (src/Trailer, #706): films the trailers with tools/trailer.sh, never a player's tool -->
  <PropertyGroup Condition=" '$(UnitSportTrailer)' == 'true' ">
    <DefineConstants>$(DefineConstants);TRAILER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition=" '$(UnitSportTrailer)' != 'true' ">
    <Compile Remove="src/Trailer/**" />
  </ItemGroup>

</Project>

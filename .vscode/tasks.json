{
    // Godot is taken from "godotTools.editorPath.godot4" in .vscode/settings.json (a Windows path);
    // on macOS each task's "osx" override runs /Applications/Godot_mono.app instead, and on
    // Linux/WSL its "linux" override runs `godot` from PATH (the .NET build of 4.7.1).
    // Every task that launches the game builds the C# first: launching Godot from the
    // command line does not compile the assembly the way F5 in the editor does.
    // Check and probe output goes to test_output/ (gitignored).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "dotnet build the game, TerrainFormat and TerrainPreprocessor",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "UnitSportSwitzerland.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build: RoadGen",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "tools/RoadGen",
                "-c",
                "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "godot: import",
            "detail": "First-time headless import (creates .godot/)",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--headless",
                "--path",
                ".",
                "--import"
            ],
            "problemMatcher": []
        },
        {
            "label": "run: game",
            "detail": "Offline, main menu",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                "."
            ],
            "dependsOn": "build",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "run: game from worktree",
            "detail": "Pick a local feature worktree in the terminal, build it and run the game from there",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "tools/run-worktree.ps1",
                "${config:godotTools.editorPath.godot4}",
                "${input:gameArgs}"
            ],
            "osx": {
                "command": "bash",
                "args": [
                    "tools/run-worktree.sh",
                    "/Applications/Godot_mono.app/Contents/MacOS/Godot",
                    "${input:gameArgs}"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "tools/run-worktree.sh",
                    "godot",
                    "${input:gameArgs}"
                ]
            },
            "presentation": {
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run: game at LV95",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--at",
                "${input:lv95}"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "run: game at town",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--goto",
                "${input:town}"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "run: GPX replay",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--gpx",
                "${input:gpx}"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "run: signal test region",
            "detail": "Rebuild the traffic-lights test region (#386, RoadGen --test-region, ~2 s) and play at a junction, 150 cars",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--chunks",
                "test_output/signal-region",
                "--at",
                "${input:signalJunction}",
                "--traffic",
                "150",
                "--generated",
                "off",
                "--title",
                "signal test region"
            ],
            "dependsOn": [
                "build",
                "data: signal test region"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "run: fixture course",
            "detail": "A test course built in code (--chunks fixture:<course>, docs/notes/general/testing.md), traffic on",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--chunks",
                "fixture:${input:fixtureCourse}",
                "--traffic",
                "150",
                "--title",
                "fixture ${input:fixtureCourse}"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "run: model viewer",
            "detail": "Procedural models one at a time: Left/Right switch, drag orbits, wheel zooms",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--models"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "run: editor",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--editor"
            ],
            "dependsOn": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "mp: dedicated server",
            "detail": "Headless server on port 7777; type /commands into this terminal",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--headless",
                "--path",
                ".",
                "--",
                "--server",
                "--admin-password",
                "${input:adminPassword}"
            ],
            "dependsOn": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "mp: client (localhost)",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--connect",
                "127.0.0.1",
                "--name",
                "${input:playerName}"
            ],
            "problemMatcher": []
        },
        {
            "label": "mp: client (host)",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--connect",
                "${input:host}",
                "--name",
                "${input:playerName}"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: smoke screenshot",
            "detail": "SETUP.md step 3 - boots and writes test_output/smoke.png",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--shot",
                "0,300,0,-20,0,3,test_output/smoke.png"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: screenshot",
            "detail": "--shot x,y,z,pitchDeg,yawDeg,seconds,out.png",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--shot",
                "${input:shot}"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: streaming smoothness (--fly)",
            "detail": "Straight flight, prints frame-time distribution, fails on any frame > 33 ms",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--fly",
                "${input:fly}"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: ride",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--ride",
                "${input:rideKind},20,test_output/ride_${input:rideKind}.png"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: flight model",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--flycheck",
                "${input:craft},test_output/flycheck_${input:craft}.png"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: vehicles",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--vehiclecheck,test_output/vehiclecheck.png",
                "--at",
                "2585000,1110000"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: road collision",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--roadcheck"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: bridge collision",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--roadcheck",
                "--bridges"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: mantle",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--mantlecheck"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: traffic",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--trafficcheck,test_output/trafficcheck.png"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: gathering",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--gathercheck,test_output/gathercheck.png"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: loot stats",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--path",
                ".",
                "--",
                "--lootstats"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "check: sound",
            "detail": "Writes every sound bank as WAV to test_output/soundcheck, fails on NaN/clipping",
            "type": "process",
            "command": "${config:godotTools.editorPath.godot4}",
            "osx": {
                "command": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
            },
            "linux": {
                "command": "godot"
            },
            "args": [
                "--headless",
                "--path",
                ".",
                "--",
                "--soundcheck",
                "test_output/soundcheck"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "data: map setup wizard",
            "detail": "MapSetup: pick tiles on the map of CH, then download and build them",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tools/MapSetup",
                "-c",
                "Release"
            ],
            "presentation": {
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "data: map setup wizard (resume)",
            "detail": "MapSetup --resume: continue the last selection's pipeline",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tools/MapSetup",
                "-c",
                "Release",
                "--",
                "--resume"
            ],
            "presentation": {
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "data: coarse companions + horizon",
            "detail": "Regenerate .terrc tiles and horizon.bin from existing .terr",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tools/TerrainPreprocessor",
                "-c",
                "Release",
                "--",
                "--out",
                "terrain_chunks",
                "--coarse",
                "--jobs",
                "8"
            ],
            "problemMatcher": []
        },
        {
            "label": "data: far horizon",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tools/TerrainPreprocessor",
                "-c",
                "Release",
                "--",
                "--out",
                "terrain_chunks",
                "--horizon",
                "--jobs",
                "8"
            ],
            "problemMatcher": []
        },
        {
            "label": "data: junctions dry run",
            "detail": "RoadGen --rewrite --dry-run: measure without touching .road files",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tools/RoadGen",
                "-c",
                "Release",
                "--",
                "--rewrite",
                "--dry-run",
                "--chunks",
                "terrain_chunks"
            ],
            "problemMatcher": []
        },
        {
            "label": "data: signal test region",
            "detail": "RoadGen --test-region: the traffic-lights test region (#386) into test_output/signal-region, junction table on stdout",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tools/RoadGen",
                "-c",
                "Release",
                "--",
                "--test-region",
                "test_output/signal-region"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "data: RoadGen demo",
            "detail": "Four hand-built junction scenes, no data needed",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "tools/RoadGen",
                "-c",
                "Release",
                "--",
                "--demo"
            ],
            "problemMatcher": []
        },
        {
            "label": "release: dry run",
            "detail": "Next version and changelog since the last v* tag, builds nothing",
            "type": "process",
            "command": "C:/Program Files/Git/bin/bash.exe",
            "args": [
                "tools/release.sh",
                "--dry-run"
            ],
            "osx": {
                "command": "bash",
                "options": {
                    "env": {
                        "GODOT": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
                    }
                }
            },
            "linux": {
                "command": "bash",
                "options": {
                    "env": {
                        "GODOT": "godot"
                    }
                }
            },
            "presentation": {
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "release: build and publish",
            "detail": "Export Windows Desktop, zip it and gh release create vX.Y.Z (public)",
            "type": "process",
            "command": "C:/Program Files/Git/bin/bash.exe",
            "args": [
                "tools/release.sh"
            ],
            "osx": {
                "command": "bash",
                "options": {
                    "env": {
                        "GODOT": "/Applications/Godot_mono.app/Contents/MacOS/Godot"
                    }
                }
            },
            "linux": {
                "command": "bash",
                "options": {
                    "env": {
                        "GODOT": "godot"
                    }
                }
            },
            "presentation": {
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        { "id": "lv95", "type": "promptString", "description": "LV95 easting,northing", "default": "2583250,1113250" },
        { "id": "town", "type": "promptString", "description": "Town or summit name", "default": "Riddes" },
        { "id": "gpx", "type": "promptString", "description": "Path to a .gpx file" },
        { "id": "gameArgs", "type": "promptString", "description": "Extra game args after --, e.g. --connect 127.0.0.1 (empty = main menu)", "default": "" },
        { "id": "host", "type": "promptString", "description": "Server host[:port]", "default": "127.0.0.1:7777" },
        { "id": "playerName", "type": "promptString", "description": "Player name", "default": "player" },
        { "id": "adminPassword", "type": "promptString", "description": "Operator password for /login", "password": true },
        { "id": "shot", "type": "promptString", "description": "x,y,z,pitchDeg,yawDeg,seconds,out.png (world coords)", "default": "0,300,0,-20,0,6,test_output/shot.png" },
        { "id": "fly", "type": "promptString", "description": "x,y,z,yawDeg,speedMps,seconds (world coords)", "default": "0,1200,0,90,150,12" },
        { "id": "rideKind", "type": "pickString", "description": "Mount", "options": ["bike", "skis", "foot"], "default": "bike" },
        { "id": "craft", "type": "pickString", "description": "Aircraft", "options": ["wingsuit", "glide", "paraglider", "heli", "plane"], "default": "wingsuit" },
        {
            // spawn on the grass 25 m south-west of each junction (J5: between the two) (docs/notes/tools/signal-test-region.md)
            "id": "signalJunction", "type": "pickString", "description": "Junction of the signal test region",
            "options": [
                { "label": "J1 ideal crossroads, painted bike lanes (2910500,1322500)", "value": "2910475,1322475" },
                { "label": "J2 ideal crossroads in town, separated bike paths (2911500,1322500)", "value": "2911475,1322475" },
                { "label": "J3 mismatched room: L|T|R, L|TR, one lane, right pocket only (2912500,1322500)", "value": "2912475,1322475" },
                { "label": "J3b a 4 m road across the main road (2913500,1322500)", "value": "2913475,1322475" },
                { "label": "J4 T junction (2914500,1322500)", "value": "2914475,1322475" },
                { "label": "J5 two lights 60 m apart (2915470,1322500 / 2915530,1322500)", "value": "2915500,1322470" }
            ],
            "default": "2910475,1322475"
        },
        {
            "id": "fixtureCourse", "type": "pickString", "description": "Fixture course (Terrain/Fixture/FixtureCourse.Names)",
            "options": ["flat", "straight", "hairpin", "narrow", "junction", "verge", "lake"], "default": "junction"
        }
    ]
}

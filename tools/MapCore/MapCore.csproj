<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0, not the terminal tool's net9.0: the game assembly references this, and that is net8 -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UnitSport.Map</RootNamespace>
    <AssemblyName>MapCore</AssemblyName>
    <!-- French locale machine: never let the current culture near a float. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- GWR cadastre and the TLM GeoPackage are SQLite; the preprocessor reads them the same way -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <ProjectReference Include="..\TerrainFormat\TerrainFormat.csproj" />
    <!-- canton polygons and the TLM GeoPackage are read with the preprocessor's GDAL-free reader -->
    <Compile Include="..\TerrainPreprocessor\GeoPackageReader.cs" Link="GeoPackageReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The baked country map, embedded rather than copied beside the binary: the game reads it
         through the assembly, so no export filter or data path can lose it (the same reason
         src/Terrain/swiss_relief.gz is embedded). WithCulture because MSBuild otherwise reads
         ".bin"-like infixes as a culture. -->
    <EmbeddedResource Include="switzerland.bin" LogicalName="switzerland.bin" WithCulture="false" />
  </ItemGroup>

</Project>

# tools/nakama/up.sh copies this to .env (gitignored) with every "change-me" replaced by a random key.
# On a server, keep its .env: replacing the encryption key logs every player out, the Postgres password locks the volume.
POSTGRES_PASSWORD=change-me
NAKAMA_SERVER_KEY=change-me
NAKAMA_HTTP_KEY=change-me
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me
NAKAMA_ENCRYPTION_KEY=change-me
# Host ports (check.sh uses others so it never touches this stack)
NAKAMA_PORT=7350
# 127.0.0.1: only this machine (behind Caddy, #1205); 0.0.0.0: every interface
NAKAMA_BIND=127.0.0.1
NAKAMA_CONSOLE_PORT=7351

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UnitSport.Tools.MapSetup</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <ProjectReference Include="..\TerrainFormat\TerrainFormat.csproj" />
    <!-- canton polygons are read with the preprocessor's GDAL-free GeoPackage reader -->
    <Compile Include="..\TerrainPreprocessor\GeoPackageReader.cs" Link="GeoPackageReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the baked country map ships next to the binary, so a fresh clone draws it offline -->
    <None Include="switzerland.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('switzerland.bin')" />
  </ItemGroup>

</Project>

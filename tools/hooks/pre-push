#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath tools/hooks
# When main is pushed, release it in the background (tools/release.sh builds from the pushed commit).
while read -r _ sha ref _; do
  if [ "$ref" = refs/heads/main ] && [ "$sha" != 0000000000000000000000000000000000000000 ]; then
    mkdir -p test_output/release
    nohup bash tools/release.sh --after-push "$sha" > test_output/release/last-run.log 2>&1 &
    echo "release: started in background for ${sha:0:7} (log: test_output/release/last-run.log)"
  fi
done
exit 0

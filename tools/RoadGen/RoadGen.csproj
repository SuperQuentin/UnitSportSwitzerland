<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UnitSport.Tools.RoadGen</RootNamespace>
    <!-- French locale machine: never let the current culture near a float. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Standalone runs its blocks at once (#1539), like the preprocessor; only this exe's runtimeconfig, never the game's. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerrainFormat\TerrainFormat.csproj" />
  </ItemGroup>

</Project>

# Copy to tools/deploy.env (gitignored) and edit. Read by tools/deploy-linux.sh; env vars override it.
DEPLOY_HOST=user@my-server          # ssh target; key auth (ssh-copy-id) and sudo rights needed
DEPLOY_PORT_SSH=22                  # sshd port, also opened in ufw before the firewall is enabled
DEPLOY_DIR=/opt/unitsport           # releases/, current -> releases/<stamp>, start-server.sh, server.log
DEPLOY_CHUNKS_DIR=                  # empty = $DEPLOY_DIR/terrain_chunks; point at a data volume for the ~100 GB of tiles
GAME_PORT=7777                      # ENet UDP port (--port), advertised over mDNS
WEB_PORTS="80 443"                  # TCP ports opened in ufw for a web page
MDNS_NAME="UnitSport Server"        # name shown in the client's "Servers on your network" list
SERVER_ARGS=""                      # extra server args, e.g. "--stream-bandwidth 2"
SPACE_MARGIN_MB=2048                # free space that must remain after an upload

# Copy to tools/deploy.env (gitignored) and edit. Read by tools/deploy-linux.sh; env vars override it.
DEPLOY_HOST=user@my-server          # ssh target; key auth (ssh-copy-id) and sudo rights needed
DEPLOY_PORT_SSH=22                  # sshd port, also opened in ufw before the firewall is enabled
DEPLOY_DIR=/opt/unitsport           # releases/, current -> releases/<stamp>, start-server.sh, server.log
DEPLOY_CHUNKS_DIR=                  # empty = $DEPLOY_DIR/terrain_chunks; point at a data volume for the ~100 GB of tiles
GAME_PORT=7777                      # ENet UDP port (--port), advertised over mDNS
WEB_PORTS="80 443"                  # TCP ports opened in ufw: the tiles over HTTP (TILES), a web page
MDNS_NAME="UnitSport Server"        # name shown in the client's "Servers on your network" list
SERVER_ARGS=""                      # extra server args, e.g. "--stream-bandwidth 2"
SPACE_MARGIN_MB=2048                # free space that must remain after an upload
TILES=1                             # 1 = Caddy serves the tiles over HTTP under /tiles/ and clients fetch them there (#651)
TILES_DOMAIN=                       # a DNS name pointing at the host = HTTPS + HTTP/2 (Let's Encrypt); empty = plain http://<host>:80
TILES_URL=                          # empty = derived from TILES_DOMAIN or DEPLOY_HOST; set it for a CDN in front
TILES_PRECOMPRESS=1                 # gzip copies beside the tiles (~+25% disk, .terr 2 MB -> 0.4 MB); 0 = gzip on the fly
# House layouts (#1186, docs/notes/net/house-layouts.md): houses.html + the layout service at /api/ (needs TILES=1)
LAYOUTS=1                           # 0 = no house layout page or service
LAYOUTS_ADMINS=""                   # comma-separated emails of the moderators who approve layouts
LAYOUTS_PUBLIC_URL=                 # empty = https://TILES_DOMAIN, else TILES_URL without /tiles/; the login link points here
LAYOUTS_DB=                         # empty = SQLite in $DEPLOY_DIR/layouts; or PostgreSQL: "Host=...;Database=...;Username=...;Password=..." or postgres://user:pass@host/db
LAYOUTS_PORT=5080                   # loopback port Caddy proxies /api/ to
LAYOUTS_TRUSTED_PROXIES=            # the proxy in front of Caddy (e.g. 195.48.14.221), so rate limits see visitors, not the proxy
SMTP_HOST=                          # the mail server sending login links; empty = links go to $DEPLOY_DIR/layouts/layouts.log
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                          # e.g. unitsport@example.ch

<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Installed to /etc/avahi/services/unitsport.service by tools/deploy/remote-setup.sh.
     The game client browses _unitsport._udp (src/Net/LanDiscovery.cs). -->
<service-group>
  <name>@MDNS_NAME@</name>
  <service>
    <type>_unitsport._udp</type>
    <port>@GAME_PORT@</port>
    <txt-record>version=@VERSION@</txt-record>
  </service>
</service-group>

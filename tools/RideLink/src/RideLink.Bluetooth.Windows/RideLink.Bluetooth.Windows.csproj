<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinRT projection for Windows.Devices.Bluetooth. 10.0.19041.0 is the 2004 SDK, which is
      where the GATT surface this transport uses settled; SupportedOSPlatformVersion is kept
      lower so the assembly still loads on older Windows 10 and fails at the adapter check
      rather than at assembly load.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- the game's Windows export is built on Linux too (#1170, NETSDK1100) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>RideLink.Bluetooth.Windows</RootNamespace>
    <Description>
      Windows desktop BLE transport for RideLink, binding Windows.Devices.Bluetooth (WinRT)
      directly — no third-party BLE dependency.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RideLink\RideLink.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the generated-terrain blend (src/Terrain/ProceduralWorld.Blend.cs) and the source that
       serves it (FallbackChunkSource under CachingChunkSource) against synthetic real terrain, with
       no Godot: the generator and the source chain are plain C# over TerrainFormat. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- the generator's doc comments cref game types this project does not compile -->
    <NoWarn>CS1574;CS1584;CS1581;CS1580</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Terrain\ProceduralWorld*.cs" Link="Generator\%(Filename)%(Extension)" />
    <!-- #1509 G2 B5: the generated world as cube leaves -->
    <!-- LeafStandIn is the game's (its stand-in tiles' water layers and building ids since #1634, #1658): none of the checks reads it -->
    <!-- the earth fill's biomes (#1809), applied by GeneratedLeaves -->
    <Compile Include="..\..\src\Terrain\Biomes\*.cs" Link="Biomes\%(Filename)%(Extension)" />
    <!-- LeafTileName names store files from a GlobalPos (Godot, #1726 D2): none of the checks reads it -->
    <Compile Include="..\..\src\Terrain\Leaves\*.cs" Exclude="..\..\src\Terrain\Leaves\LeafStandIn.cs;..\..\src\Terrain\Leaves\SitePads.cs;..\..\src\Terrain\Leaves\LeafTileName.cs" Link="Leaves\%(Filename)%(Extension)" />
    <!-- the source chain the game runs it through: generation, blend loads, cache invalidation -->
    <Compile Include="..\..\src\Terrain\IChunkSource.cs;..\..\src\Terrain\FallbackChunkSource.cs;..\..\src\Terrain\FillDomain.cs;..\..\src\Terrain\FallbackChunkSource.Roads.cs;..\..\src\Terrain\CachingChunkSource.cs;..\..\src\Terrain\EmptyChunkSource.cs" Link="Source\%(Filename)%(Extension)" />
    <!-- the road embankment blend (#125), checked on real tiles by the roads mode -->
    <Compile Include="..\..\src\Terrain\TerrainMeshBuilder.RoadBlend.cs" Link="Roads\%(Filename)%(Extension)" />
    <ProjectReference Include="..\TerrainFormat\TerrainFormat.csproj" />
    <!-- generated roads go through the road network stage (#559) -->
    <ProjectReference Include="..\RoadGen\RoadGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the coarse heightmap the generated terrain is shaped on (tools/swiss_relief.py); LogicalName
         and WithCulture because MSBuild otherwise reads ".bin"-like infixes as a culture -->
    <EmbeddedResource Include="..\..\src\Terrain\swiss_relief.gz" LogicalName="swiss_relief.gz" WithCulture="false" />
    <!-- the earth fill's biomes (#1809): their photo statistics -->
    <EmbeddedResource Include="..\..\src\Terrain\Biomes\photo_stats.bin.gz" LogicalName="photo_stats.bin.gz" WithCulture="false" />
  </ItemGroup>

</Project>

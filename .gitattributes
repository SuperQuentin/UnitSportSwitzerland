# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
# Binary assets of the visual styles live in Git LFS (docs/notes/styles/assets.md)
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/**/*.xm filter=lfs diff=lfs merge=lfs -text
assets/**/*.mod filter=lfs diff=lfs merge=lfs -text
# the globe's shipped levels 0-2 (#1430 H4), heights and colour bundles: rebaked whole, so never in plain history
assets/globe/*.cubb filter=lfs diff=lfs merge=lfs -text
assets/globe/*.cuba filter=lfs diff=lfs merge=lfs -text

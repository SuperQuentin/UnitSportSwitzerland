         bytes, Godot maths only -->
    <Compile Include="..\..\src\Terrain\BuildingTriangles.cs" Link="Game\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Interiors\PlanBox.cs" Link="Game\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Interiors\BuildingTypes.cs" Link="Game\%(Filename)%(Extension)" />
    <!-- building sites (#606): the planner, Godot maths only -->
    <Compile Include="..\..\src\Terrain\Construction\ConstructionSite.cs" Link="Game\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Terrain\Construction\ShellPlan.cs" Link="Game\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Terrain\Construction\SiteDressing.cs" Link="Game\%(Filename)%(Extension)" />
    <!-- swiss_data.py port (#515): only the pure half (manifest format, skip decisions, STAC
         id/bbox arithmetic) is linked. SwissDownload.cs itself needs IStepProgress from
         Pipeline.cs, which would drag in CountryData/LocalState/Selection/Stats and
         TerrainPreprocessor-only types this project has no ProjectReference for. -->
    <Compile Include="..\..\tools\MapCore\DownloadManifest.cs" Link="Map\%(Filename)%(Extension)" />
    <!-- FileGDB reader (#537): the geometry decoding is pure arithmetic and tested here; FileGdb.cs
         itself is linked only for the GeometryGrid the decoder takes. -->
    <Compile Include="..\..\tools\TerrainPreprocessor\FileGdbGeometry.cs" Link="Gdb\%(Filename)%(Extension)" />
    <Compile Include="..\..\tools\TerrainPreprocessor\FileGdb.cs" Link="Gdb\%(Filename)%(Extension)" />
    <!-- update check (#532): version compare, asset pick, GitHub's JSON, delta updates -->
    <Compile Include="..\..\src\Core\UpdateInfo.cs;..\..\src\Core\BinaryDelta.cs;..\..\src\Core\UpdatePackage.cs" Link="Game\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Interiors\Landmarks.cs" Link="Game\%(Filename)%(Extension)" />
    <!-- forklift pallets (#583): the load byte, the ids and the fork rule, against the forks' numbers;
         and the stacks on a site's apron (phase 3) -->
    <Compile Include="..\..\src\Avatar\ForkliftLayout.cs;..\..\src\Items\Pallets.cs;..\..\src\Items\SitePallets.cs" Link="Game\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
